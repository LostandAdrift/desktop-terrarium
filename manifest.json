{
  "schemaVersion": 1,
  "id": "io.github.lostandadrift.terrarium",
  "name": "Desktop Terrarium",
  "version": "0.1.0",
  "author": "LostandAdrift",
  "description": "A living world shaped by your computer's activity. Native, private, and quietly playful.",
  "license": "MIT",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Terrarium.qml" },
  "barWidget": {
    "displayName": "Terrarium",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "reducedMotion": false, "palette": "auto", "ambient": false, "ambientDisplay": "", "ambientCorner": "bottom-right", "ambientSize": "medium" },
    "schema": [
      { "key": "reducedMotion", "type": "boolean", "label": "Reduce motion" },
      { "key": "ambient", "type": "boolean", "label": "Pin a garden behind windows" },
      { "key": "ambientDisplay", "type": "string", "label": "Pinned display (blank for automatic)" },
      { "key": "ambientCorner", "type": "enum", "label": "Pinned corner", "options": ["bottom-right", "bottom-left", "top-right", "top-left"], "defaultValue": "bottom-right" },
      { "key": "ambientSize", "type": "enum", "label": "Pinned size", "options": ["small", "medium", "large"], "defaultValue": "medium" },
      { "key": "palette", "type": "enum", "label": "Palette", "options": ["auto", "dusk", "dawn", "moss"], "defaultValue": "auto" }
    ]
  }
}
